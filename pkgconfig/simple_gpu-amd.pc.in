prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: simple_gpu_amd
Description: Simple GPU - Fortran GPU Computing Library (AMD GPU version)
Version: @VERSION@
Requires:
Libs: -L${libdir} -lsimple_gpu-amd @ROCM_LDFLAGS@ @ROCM_LIBS@
Cflags: -I${includedir} @ROCM_CFLAGS@
